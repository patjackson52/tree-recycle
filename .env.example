# ============================================================================
# FAKE SERVICES CONFIGURATION
# ============================================================================
# This file shows available environment variables for configuring fake services
# Copy this file to .env and customize for your local development environment
#
# For development without API keys:
#   cp .env.example .env
#   (Keep all FAKE_* variables set to true)
#
# For production-like development with real services:
#   cp .env.example .env
#   Set FAKE_SERVICES_ENABLED=false
#   Add real API keys below

# ============================================================================
# MASTER TOGGLE
# ============================================================================
# Enable/disable all fake services globally
# When true, uses fake implementations for all services (unless overridden)
# When false, uses real services (requires API keys)
# Default: true in development/test, false in production
FAKE_SERVICES_ENABLED=true

# Show warnings when fake services are being used
# Helpful for development to know which services are mocked
SHOW_FAKE_SERVICE_WARNINGS=true

# ============================================================================
# INDIVIDUAL SERVICE TOGGLES
# ============================================================================
# These override FAKE_SERVICES_ENABLED for specific services
# Useful for testing with a mix of real and fake services

# Maps: Use Leaflet.js/OpenStreetMap (true) or Google Maps (false)
FAKE_MAPS=true

# Geocoding: Use cached Bainbridge Island data (true) or AWS Location Service (false)
FAKE_GEOCODER=true

# Payments: Use Stripe test mode (true) or real Stripe (false)
FAKE_STRIPE=true

# SMS: Log messages (true) or send via Twilio (false)
FAKE_TWILIO=true

# Address Validation: Bypass USPS (true) or use real USPS API (false)
FAKE_USPS=true

# ============================================================================
# REAL SERVICE CREDENTIALS
# ============================================================================
# These are only needed when corresponding FAKE_* flag is false
# For security, these should be stored in Rails credentials (credentials.yml.enc)
# rather than in .env files. The .env approach is shown here for convenience.

# -------------------
# Google Maps API
# -------------------
# Get API key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -------------------
# AWS Location Service
# -------------------
# Get credentials from: https://console.aws.amazon.com/
# Enable: Amazon Location Service
# Create Place Index named: tree_recycle
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_REGION=us-west-2

# -------------------
# Stripe
# -------------------
# Get keys from: https://dashboard.stripe.com/
# Use test keys for FAKE_STRIPE=true
# Use live keys for FAKE_STRIPE=false
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
# STRIPE_SECRET_KEY=sk_test_your_test_key_here

# -------------------
# Twilio
# -------------------
# Get credentials from: https://console.twilio.com/
# Purchase a phone number
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# -------------------
# USPS API
# -------------------
# Get User ID from: https://www.usps.com/business/web-tools-apis/
# Free for development
# USPS_USER_ID=your_usps_user_id_here

# -------------------
# Rollbar (Error Tracking)
# -------------------
# Get token from: https://rollbar.com/
# Optional for development
# ROLLBAR_ACCESS_TOKEN=your_rollbar_access_token_here

# -------------------
# Redis
# -------------------
# For caching and background jobs
# Local development: redis://localhost:6379/0
# Render.com: Automatically set by Render
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# DATABASE
# ============================================================================
# For production deployment (Render.com sets this automatically)
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# ============================================================================
# RAILS CONFIGURATION
# ============================================================================
# Rails master key for decrypting credentials
# Get from: cat config/master.key
# CRITICAL: Keep this secret! Never commit to git!
# RAILS_MASTER_KEY=your_rails_master_key_here

# Rails environment
# RAILS_ENV=development

# Serve static files in production
# RAILS_SERVE_STATIC_FILES=true

# ============================================================================
# DEVELOPMENT HELPERS
# ============================================================================
# Skip asset precompilation for faster local development
# SKIP_ASSET_PRECOMPILE=true

# Enable SQL query logging
# VERBOSE_QUERY_LOGS=true

# ============================================================================
# USAGE EXAMPLES
# ============================================================================

# Example 1: Pure fake services (no API keys needed)
# FAKE_SERVICES_ENABLED=true
# SHOW_FAKE_SERVICE_WARNINGS=true
# Result: Everything uses fake implementations

# Example 2: Real maps, fake everything else
# FAKE_SERVICES_ENABLED=true
# FAKE_MAPS=false
# GOOGLE_MAPS_API_KEY=your_real_google_key
# Result: Google Maps displays, but geocoding/SMS/etc are faked

# Example 3: All real services
# FAKE_SERVICES_ENABLED=false
# [Add all real API keys above]
# Result: Production-like environment

# Example 4: Testing payment flow with real Stripe test mode
# FAKE_SERVICES_ENABLED=true
# FAKE_STRIPE=false
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# Result: Real Stripe test mode, fake everything else

# ============================================================================
# NOTES
# ============================================================================
# - .env files should NEVER be committed to git (see .gitignore)
# - For production, use Rails encrypted credentials or Render environment variables
# - Fake services are perfect for development, but use real services for production
# - All FAKE_* flags default to FAKE_SERVICES_ENABLED value if not specified
# - See FAKE_SERVICES_PLAN.md for detailed implementation information
# - See DEPLOYMENT_REQUIREMENTS.md for production setup details
